"""
ADVANCED HYBRID DERIV DIGIT BOT V2.0
Features: Auto Switcher + Trend + Time Filter + Risk Manager + Email Alerts
For Pydroid 3 + Deriv
"""

import asyncio
import websockets
import json
import smtplib
from email.message import EmailMessage
import ssl
from datetime import datetime
import pytz # pip install pytz

try:
    from config import DERIV_TOKEN, EMAIL_USER, EMAIL_PASS, TO_EMAIL
except:
    print("❌ Create config.py first!")
    exit()

# ========== ADVANCED SETTINGS ==========
APP_ID = '1089'
SYMBOL = 'R_100'
SCAN_TICKS = 50
THRESHOLD_RARE = 8 # <= 8/50 = Rare = Matches
THRESHOLD_COMMON = 15 # >= 15/50 = Common = Differs

TRADE_DURATION = 5
MAX_LOSS_STREAK = 2
PAUSE_TICKS = 20
TREND_LOOKBACK = 5
TRADE_HOURS_START = 8 # 08:00 GMT
TRADE_HOURS_END = 22 # 22:00 GMT
# =======================================

digit_counts = [0]*10
ticks = []
prices = []
last_signal = ""
last_signal_tick = 0
tick_counter = 0
loss_streak = 0
in_pause = False
pause_counter = 0
current_mode = "SCANNING"

ssl_context = ssl.create_default_context()
ssl_context.check_hostname = False
ssl_context.verify_mode = ssl.CERT_NONE
gmt = pytz.timezone('GMT')

async def send_email(subject, body, alert_type="INFO"):
    emoji = {"SIGNAL":"📊", "WARNING":"⚠️", "PAUSE":"⏸️", "INFO":"✅"}.get(alert_type, "ℹ️")
    msg = EmailMessage()
    msg.set_content(body)
    msg['Subject'] = f"{emoji} {subject}"
    msg['From'] = EMAIL_USER
    msg['To'] = TO_EMAIL
    try:
        with smtplib.SMTP_SSL('smtp.gmail.com', 465, timeout=10) as smtp:
            smtp.login(EMAIL_USER, EMAIL_PASS)
            smtp.send_message(msg)
        print(f"{emoji} Email Sent: {subject}")
    except Exception as e:
        print("Email error:", e)

def check_time_filter():
    now = datetime.now(gmt).hour
    return TRADE_HOURS_START <= now < TRADE_HOURS_END

def check_trend():
    if len(prices) < TREND_LOOKBACK + 1:
        return None
    return "UP" if prices[-1] > prices[-TREND_LOOKBACK - 1] else "DOWN"

def get_best_digit():
    # Find rarest and most common digit
    rarest_digit = digit_counts.index(min(digit_counts))
    common_digit = digit_counts.index(max(digit_counts))
    return rarest_digit, common_digit

async def hybrid_trade_logic(price):
    global digit_counts, ticks, prices, last_signal, last_signal_tick, tick_counter
    global loss_streak, in_pause, pause_counter, current_mode

    tick_counter += 1
    last_digit = int(str(price)[-1])
    ticks.append(last_digit)
    prices.append(price)
    
    if len(ticks) > SCAN_TICKS:
        removed = ticks.pop(0)
        digit_counts[removed] -= 1
    if len(prices) > SCAN_TICKS:
        prices.pop(0)
    digit_counts[last_digit] += 1
    
    # PAUSE MANAGER
    if in_pause:
        pause_counter += 1
        if pause_counter >= PAUSE_TICKS:
            in_pause = False
            pause_counter = 0
            loss_streak = 0
            await send_email("Bot Resumed", "Risk pause ended. Resuming scan.", "INFO")
        return

    if len(ticks) < SCAN_TICKS:
        print(f"Scanning... {len(ticks)}/{SCAN_TICKS} | Last: {last_digit}")
        return
    
    # HYBRID LOGIC
    time_ok = check_time_filter()
    trend = check_trend()
    cooldown_ok = (tick_counter - last_signal_tick) >= TRADE_DURATION
    risk_ok = loss_streak < MAX_LOSS_STREAK
    rarest, common = get_best_digit()
    
    # AUTO SWITCHER LOGIC
    signal_type = None
    target_digit = None
    if digit_counts[rarest] <= THRESHOLD_RARE:
        signal_type = "MATCHES"
        target_digit = rarest
    elif digit_counts[common] >= THRESHOLD_COMMON:
        signal_type = "DIFFERS"
        target_digit = common
    
    can_send = signal_type and trend and time_ok and cooldown_ok and risk_ok
    
    if can_send and last_signal!= f"{signal_type}_{target_digit}":
        subject = f"HYBRID SIGNAL: {signal_type} {target_digit}"
        body = f"""Symbol: {SYMBOL}
Time GMT: {datetime.now(gmt).strftime('%Y-%m-%d %H:%M:%S')}
Strategy: Auto-Switcher + Trend + Time
Reason: {signal_type} {target_digit}. Rarest:{rarest}={digit_counts[rarest]} Common:{common}={digit_counts[common]}
Trend: {trend} | Last Price: {price}
Action: Trade 'Digit {signal_type} {target_digit}' for next {TRADE_DURATION} ticks
Reply to this email with WIN or LOSS to track results.
Loss Streak: {loss_streak}"""
        await send_email(subject, body, "SIGNAL")
        print("✅ SIGNAL SENT:", subject)
        last_signal = f"{signal_type}_{target_digit}"
        last_signal_tick = tick_counter
        current_mode = f"SIGNALED {signal_type}"
    
    elif not time_ok:
        if current_mode!= "OUT_OF_HOURS":
            await send_email("Trading Paused", f"Outside trading hours {TRADE_HOURS_START}:00-{TRADE_HOURS_END}:00 GMT", "WARNING")
            current_mode = "OUT_OF_HOURS"
    
    else:
        print(f"Tick:{last_digit} | Rarest:{rarest}={digit_counts[rarest]} | Trend:{trend} | Mode:{current_mode}")


async def main():
    uri = f"wss://ws.binaryws.com/websockets/v3?app_id={APP_ID}"
    await send_email("✅ Bot V2 Started", "Advanced Hybrid Bot Online", "INFO")

    while True:
        try:
            print("🔄 Connecting...")
            async with websockets.connect(uri, ssl=ssl_context) as ws:
                await ws.send(json.dumps({"authorize": DERIV_TOKEN}))
                auth_res = json.loads(await asyncio.wait_for(ws.recv(), timeout=15))
                if 'error' in auth_res:
                    await send_email("AUTH FAILED", auth_res['error']['message'], "WARNING")
                    await asyncio.sleep(5)
                    continue

                print("✅ Authenticated:", auth_res['authorize']['email'])
                await ws.send(json.dumps({"ticks": SYMBOL, "subscribe": 1}))
                print("📡 ADVANCED HYBRID SCAN STARTED")

                while True:
                    data = json.loads(await asyncio.wait_for(ws.recv(), timeout=60))
                    if 'tick' in data:
                        await hybrid_trade_logic(data['tick']['quote'])

        except Exception as e:
            await send_email("BOT CRASHED", str(e), "WARNING")
            print("Error:", e)
        await asyncio.sleep(5)

asyncio.run(main())
